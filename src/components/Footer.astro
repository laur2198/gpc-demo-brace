---
import Logo from './Logo.astro';

const links = [
  { href: '/', label: 'Acasă' },
  { href: '/meniu/', label: 'Meniu' },
  { href: '/povestea/', label: 'Povestea' },
  { href: '/galerie/', label: 'Galerie' },
  { href: '/rezervari/', label: 'Rezervări' },
];
---

<footer class="mt-24 bg-charcoal text-cream/80">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="space-y-3">
      <div class="text-cream text-2xl"><Logo /></div>
      <p class="text-sm text-cream/60">Cucina italiana · Brașov</p>
    </div>

    <nav aria-label="Navigație footer">
      <h2 class="mb-3 text-sm font-medium tracking-wide text-cream">Pagini</h2>
      <ul class="space-y-2 text-sm">
        {links.map((l) => (
          <li>
            <a href={l.href} class="text-cream/70 transition-colors hover:text-terracotta">{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="mb-3 text-sm font-medium tracking-wide text-cream">Program</h2>
      <p class="text-sm text-cream/70">Marți–Duminică<br />12:00–23:00</p>
      <p class="mt-2 text-sm text-cream/70">Luni închis</p>
    </div>

    <div>
      <h2 class="mb-3 text-sm font-medium tracking-wide text-cream">Contact</h2>
      <p class="text-sm text-cream/70">Str. Mureșenilor 8, Brașov</p>
      <p class="mt-2 text-sm text-cream/70">0700 000 000</p>
    </div>
  </div>

  <div class="border-t border-cream/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-5 text-xs text-cream/50 sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 BRACE Trattoria</p>
      <p>Proiect concept realizat de Green Phoenix Concept.</p>
    </div>
  </div>
</footer>
