---
interface Props {
  index: string;
  eyebrow: string;
  flip?: boolean;
}
const { index, eyebrow, flip = false } = Astro.props;
---

<div
  class:list={[
    'grid items-center gap-8 py-14 lg:grid-cols-12 lg:gap-12 lg:py-20',
  ]}
  data-story-block
>
  <div class:list={['lg:col-span-3', flip ? 'lg:order-last lg:text-right' : '']}>
    <span class="font-display text-6xl text-terracotta/25 lg:text-7xl" aria-hidden="true">{index}</span>
    <p class="mt-2 text-xs font-medium tracking-[0.22em] text-terracotta">{eyebrow}</p>
  </div>
  <div class="lg:col-span-9">
    <p class="font-display text-2xl leading-snug text-charcoal sm:text-[2rem] sm:leading-[1.25]" data-reveal>
      <slot />
    </p>
  </div>
</div>
