---
import Logo from './Logo.astro';

const links = [
  { href: '/', label: 'Acasă' },
  { href: '/meniu/', label: 'Meniu' },
  { href: '/povestea/', label: 'Povestea' },
  { href: '/galerie/', label: 'Galerie' },
  { href: '/rezervari/', label: 'Rezervări' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-charcoal/10 bg-cream/85 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5" aria-label="Navigație principală">
    <a href="/" class="text-charcoal text-xl" aria-label="BRACE — acasă">
      <Logo />
    </a>

    <ul class="hidden items-center gap-7 text-sm md:flex">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={[
              'transition-colors hover:text-terracotta',
              isActive(l.href) ? 'text-terracotta font-medium' : 'text-charcoal/80',
            ]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="/rezervari/"
          class="rounded-full bg-terracotta px-4 py-2 text-cream transition-colors hover:bg-ember"
        >
          Rezervă o masă
        </a>
      </li>
    </ul>

    {/* mobil: toggle prin <details>, fără JS */}
    <details class="group relative md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md text-charcoal"
        aria-label="Deschide meniul"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </summary>
      <ul class="absolute right-0 top-12 w-52 rounded-xl border border-charcoal/10 bg-cream p-2 shadow-xl">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={[
                'block rounded-lg px-3 py-2.5 text-sm transition-colors hover:bg-charcoal/5',
                isActive(l.href) ? 'text-terracotta font-medium' : 'text-charcoal',
              ]}
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
</header>
