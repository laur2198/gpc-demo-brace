---
import Logo from './Logo.astro';

const links = [
  { href: '/', label: 'Acasă' },
  { href: '/meniu/', label: 'Meniu' },
  { href: '/povestea/', label: 'Povestea' },
  { href: '/galerie/', label: 'Galerie' },
  { href: '/rezervari/', label: 'Rezervări' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<nav class="nav" aria-label="Navigație principală">
  <Logo />
  <div class="navlinks">
    {links.map((l) => (
      <a href={l.href} class:list={[isActive(l.href) && 'active']} aria-current={isActive(l.href) ? 'page' : undefined}>
        {l.label}
      </a>
    ))}
  </div>
  <a href="/rezervari/" class="nav-cta">Rezervă o masă</a>

  {/* mobil: meniu prin <details>, fără JS */}
  <details class="navtoggle" style="position:relative">
    <summary aria-label="Deschide meniul" style="list-style:none;cursor:pointer;color:var(--cream);display:flex;align-items:center;height:40px;width:40px;justify-content:center">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </summary>
    <ul style="position:absolute;right:0;top:46px;background:var(--charcoal);border:1px solid rgba(244,236,225,.15);border-radius:12px;padding:.5rem;min-width:13rem;list-style:none;z-index:60">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            style="display:block;padding:.7rem .9rem;color:var(--cream);text-decoration:none;font-size:.9rem;border-radius:8px"
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </details>
</nav>
