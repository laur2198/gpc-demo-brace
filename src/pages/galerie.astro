---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';

// 8 dale asimetrice (6 imagini distincte → reuse pe 2).
const tiles = [
  { img: 'hero', cls: 'r43 gp1', cap: 'Grătar pe jar', eager: true },
  { img: 'dish-pizza', cls: 'r34 gp2', cap: 'Pizza napoletană', eager: true },
  { img: 'gallery-1', cls: 'r34 gp3', cap: 'Masa de seară' },
  { img: 'atmosphere', cls: 'r169 gp4', cap: 'Interior · lumină caldă' },
  { img: 'dish-pasta', cls: 'r43 gp5', cap: 'Paste · ragù' },
  { img: 'story', cls: 'r34 gp6', cap: 'La foc' },
  { img: 'dish-pizza', cls: 'r11 gp7', cap: 'Blat copt 48h' },
  { img: 'gallery-1', cls: 'r169 gp8', cap: 'Vin · detaliu' },
];
---

<Base
  title="Galerie — BRACE Trattoria · Brașov"
  description="Galerie foto BRACE: preparate la grătar pe jar, paste proaspete, pizza din cuptor cu lemne și atmosfera trattoriei, la Brașov."
>
  <section class="dark gallery">
    <div class="sec-head" data-reveal>
      <span class="eyebrow">Galerie</span>
      <h2>Din <em>bucătărie.</em></h2>
    </div>
    <div class="gal-grid eight">
      {tiles.map((t) => (
        <Figure img={t.img} cls={t.cls} cap={t.cap} eager={t.eager} reveal />
      ))}
    </div>
  </section>
</Base>
