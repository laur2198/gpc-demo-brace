---
import Base from '../layouts/Base.astro';

const blocks = [
  {
    num: '01', label: 'Începutul',
    body: 'BRACE s-a născut dintr-o obsesie simplă: mâncare italiană făcută cum trebuie, în orașul nostru. Fără compromisuri, fără „merge și așa".',
  },
  {
    num: '02', label: 'Ingredientele',
    body: 'Aducem ce e mai bun: făină italiană, roșii San Marzano, mozzarella di bufala, vită maturată. Restul îl face focul și răbdarea.',
  },
  {
    num: '03', label: 'Jarul',
    body: 'Grătarul pe jar și cuptorul cu lemne nu sunt decor. Dau gustul ăla afumat, copt, pe care nu-l poți falsifica cu o tigaie.',
  },
  {
    num: '04', label: 'Masa',
    body: 'Pentru noi, masa e despre oameni. De-aia facem porții generoase, vin bun și un loc în care nu te grăbește nimeni.',
  },
];
---

<Base
  title="Povestea — BRACE Trattoria · Brașov"
  description="Povestea BRACE: o trattoria italiană născută dintr-o obsesie pentru mâncare făcută cum trebuie, la grătar pe jar și în cuptor cu lemne, la Brașov."
>
  <header class="page-head">
    <div class="scene" aria-hidden="true"></div>
    <span class="eyebrow" data-reveal>Povestea</span>
    <h1 data-reveal>Totul pleacă <em>de la foc.</em></h1>
  </header>

  <section class="dark sec">
    <div class="wrap">
      <div class="story-blocks">
        {blocks.map((b, i) => (
          <div class:list={['sblock', i % 2 === 1 && 'flip']} data-reveal>
            <div class="sb-label">
              <span class="eyebrow">{b.label}</span>
              <span class="num">{b.num}</span>
            </div>
            <p class="sb-body" set:html={b.body} />
          </div>
        ))}

        <div class="story-cta" data-reveal>
          <a href="/rezervari/" class="btn btn-primary">Rezervă o masă →</a>
        </div>
      </div>
    </div>
  </section>
</Base>
