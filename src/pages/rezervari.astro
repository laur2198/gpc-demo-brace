---
import Base from '../layouts/Base.astro';
import ReservationForm from '../components/ReservationForm.astro';

const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=Str.+Mure%C8%99enilor+8+Bra%C8%99ov';
---

<Base
  title="Rezervări — BRACE Trattoria · Brașov"
  description="Rezervă o masă la BRACE Trattoria, Brașov. Marți–Duminică, 12:00–23:00. Pentru grupuri peste 8 persoane, sună-ne direct."
>
  <header class="page-head">
    <div class="scene short" aria-hidden="true"></div>
    <span class="eyebrow" data-reveal>Rezervări</span>
    <h1 data-reveal>Rezervă o masă <em>la BRACE.</em></h1>
  </header>

  <section class="light sec">
    <div class="wrap">
      <p class="lead" style="max-width:40rem;margin-bottom:clamp(2rem,4vw,3rem);color:#6b5d4e;font-size:1.1rem;line-height:1.7" data-reveal>
        Te așteptăm. Pentru grupuri peste 8 persoane, sună-ne direct.
      </p>

      <div class="rez-layout">
        <ReservationForm />

        <aside class="rez-aside">
          <div class="blk" data-reveal>
            <h3>Contact</h3>
            <a href="tel:+40700000000">0700 000 000</a>
            <a href="https://wa.me/40700000000" rel="noopener">WhatsApp · wa.me/40700000000</a>
            <p>Str. Mureșenilor 8, Brașov</p>
          </div>

          <div class="blk" data-reveal>
            <h3>Program</h3>
            <p>Marți–Duminică · 12:00–23:00</p>
            <p style="color:var(--muted)">Luni închis</p>
          </div>

          <a class="map-ph" href={mapsUrl} target="_blank" rel="noopener" data-reveal>
            <div class="mp-inner">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.5" />
              </svg>
              <span>Vezi pe hartă →</span>
              <span class="mp-sub">Str. Mureșenilor 8, Brașov</span>
            </div>
          </a>
        </aside>
      </div>
    </div>
  </section>
</Base>
