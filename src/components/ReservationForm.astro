---
// FORMSPREE: înlocuiește PLACEHOLDER cu ID-ul real (NU mjgznoda — ăla e GPC).
const FORMSPREE_ID = 'PLACEHOLDER';
const action = `https://formspree.io/f/${FORMSPREE_ID}`;
---

<form action={action} method="POST" class="form" data-reveal>
  {FORMSPREE_ID === 'PLACEHOLDER' && (
    <p class="form-note">⚙ Demo — formularul devine activ după ce se setează ID-ul Formspree real.</p>
  )}

  <div class="frow two">
    <div class="field">
      <label for="nume">Nume</label>
      <input id="nume" type="text" name="nume" required autocomplete="name" />
    </div>
    <div class="field">
      <label for="telefon">Telefon</label>
      <input id="telefon" type="tel" name="telefon" required autocomplete="tel" />
    </div>
  </div>

  <div class="field">
    <label for="email">Email</label>
    <input id="email" type="email" name="email" required autocomplete="email" />
  </div>

  <div class="frow three">
    <div class="field">
      <label for="data">Data</label>
      <input id="data" type="date" name="data" required />
    </div>
    <div class="field">
      <label for="ora">Ora</label>
      <input id="ora" type="time" name="ora" required min="12:00" max="23:00" />
    </div>
    <div class="field">
      <label for="persoane">Persoane</label>
      <input id="persoane" type="number" name="persoane" required min="1" max="8" value="2" />
    </div>
  </div>

  <div class="field">
    <label for="mesaj">Mesaj (opțional)</label>
    <textarea id="mesaj" name="mesaj" rows="3"></textarea>
  </div>

  <button type="submit" class="btn btn-primary">Trimite rezervarea →</button>
</form>
