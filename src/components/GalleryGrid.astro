---
import { Image } from 'astro:assets';

const sources = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.png', { eager: true });
const get = (name: string) => sources[`/src/assets/images/${name}.png`]?.default;

// 8 dale, layout asimetric. Doar 6 imagini disponibile → reuse pe 2 dale.
const tiles = [
  { img: 'gallery-1', ratio: '16/9', span: 'sm:col-span-2 lg:col-span-4', alt: 'Preparate și atmosferă BRACE' },
  { img: 'hero', ratio: '4/5', span: 'lg:col-span-2', alt: 'Friptură pe jar la BRACE' },
  { img: 'dish-pizza', ratio: '1/1', span: 'lg:col-span-2', alt: 'Pizza din cuptor cu lemne' },
  { img: 'dish-pasta', ratio: '1/1', span: 'lg:col-span-2', alt: 'Tagliatelle al ragù' },
  { img: 'atmosphere', ratio: '1/1', span: 'sm:col-span-2 lg:col-span-2', alt: 'Interiorul trattoriei' },
  { img: 'story', ratio: '3/2', span: 'sm:col-span-2 lg:col-span-3', alt: 'Gătit pe foc deschis' },
  { img: 'gallery-1', ratio: '3/2', span: 'sm:col-span-2 lg:col-span-3', alt: 'Selecție de preparate' },
  { img: 'atmosphere', ratio: '16/6', span: 'sm:col-span-2 lg:col-span-6', alt: 'Ambianța BRACE' },
];
---

<div
  class="grid grid-cols-1 items-start gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-6"
  data-gallery
>
  {tiles.map((t) => {
    const asset = get(t.img);
    return (
      <figure class={`group relative overflow-hidden rounded-2xl ${t.span}`} data-gallery-item data-reveal>
        <div
          class="relative h-full w-full transition-transform duration-700 ease-out group-hover:scale-[1.04] motion-reduce:group-hover:scale-100"
          style={`aspect-ratio:${t.ratio}`}
        >
          {asset ? (
            <Image
              src={asset}
              alt={t.alt}
              widths={[400, 800, 1152]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 600px"
              format="avif"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover"
              data-gallery-img
            />
          ) : (
            <div class="absolute inset-0 grid place-items-center bg-gradient-to-br from-charcoal via-charcoal to-terracotta text-cream/40">
              <span class="font-mono text-[0.7rem]">{t.img}.avif</span>
            </div>
          )}
        </div>
      </figure>
    );
  })}
</div>
