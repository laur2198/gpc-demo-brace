---
// Placeholder cu aspect-ratio corect până vin imaginile reale.
// Swap: înlocuiește cu <Image src=... /> din public/images/.
interface Props {
  file: string;
  ratio?: string; // ex. "16/9", "4/3", "3/2"
  eager?: boolean;
  class?: string;
}
const { file, ratio = '16/9', class: className = '' } = Astro.props;
---

<div
  class={`relative grid place-items-center overflow-hidden rounded-2xl bg-gradient-to-br from-charcoal via-charcoal to-terracotta text-cream/40 ${className}`}
  style={`aspect-ratio:${ratio}`}
  role="img"
  aria-label={`Imagine: ${file}`}
>
  <div class="flex flex-col items-center gap-1 text-center">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="opacity-50">
      <path d="M4 16l4-5 3 4 4-6 5 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="8" cy="8" r="1.6" fill="currentColor"/>
    </svg>
    <span class="font-mono text-[0.7rem] tracking-wide">{file}</span>
  </div>
</div>
