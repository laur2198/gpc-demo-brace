---
interface Cat {
  id: string;
  label: string;
}
interface Props {
  categories: Cat[];
}
const { categories } = Astro.props;
---

<nav
  class="sticky top-[57px] z-30 -mx-4 border-y border-charcoal/10 bg-cream/90 px-4 backdrop-blur-md"
  aria-label="Categorii meniu"
>
  <ul class="mx-auto flex max-w-6xl gap-1 overflow-x-auto py-3 text-sm [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    {categories.map((c) => (
      <li class="shrink-0">
        <a
          href={`#${c.id}`}
          class="rounded-full px-4 py-2 text-charcoal/75 transition-colors hover:bg-charcoal/5 hover:text-terracotta"
        >
          {c.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
